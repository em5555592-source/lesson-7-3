    {lbl:'تمرين (٤ ب): الفرق بين العددين ٢', fn:(r,b)=>Math.abs(r-b)===2, n:2, d:9, exp:'الأزواج هي (١،٣)، (٢،٤)، (٣،٥)، (٤،٦) وعكسها = ٨ نتائج من ٣٦ ← '+frac(8,36)+' = '+frac(2,9)}
  ];

  function renderMatrix(){
    const ev=curEv>=0?EVENTS[curEv]:null;
    let html='<table class="ss-table"><thead><tr><th class="row-h">أحمر \\ أزرق</th>';
    for(let b=1;b<=6;b++) html+=`<th>${ar(b)}</th>`;
    html+='</tr></thead><tbody>';
    let cnt=0;
    for(let r=1;r<=6;r++){
      html+=`<tr><th class="row-h">${ar(r)}</th>`;
      for(let b=1;b<=6;b++){
        const key=`${r},${b}`;
        const hit=manualMode?manualSet.has(key):(ev?ev.fn(r,b):false);
        if(hit)cnt++;
        const pk=(r===pickedR && b===pickedB);
        const cellTxt=(mode==='pairs')
          ? `<span dir="ltr">(<span class="red-num">${ar(r)}</span> ، <span class="blue-num">${ar(b)}</span>)</span>`
          : `${ar(r+b)}`;
        html+=`<td data-r="${r}" data-b="${b}" class="${hit?'hl':''} ${pk?'picked':''}">${cellTxt}</td>`;
      }
      html+='</tr>';
    }
    html+='</tbody></table>';
    $('#s1MatrixWrap').innerHTML=html;
    $('#s1StFav').textContent=ar(cnt);

    if(manualMode){
      const g=cnt>0?gcd(cnt,36):36;
      const sn=cnt/g, sd=36/g;
      $('#s1StProb').innerHTML=frac(sn,sd);
      $('#s1LabExplain').innerHTML=cnt===0
        ?'✍️ <b>وضع التظليل اليدوي مفعّل:</b> انقر على أي خلية في الجدول أعلاه لتظليلها وحساب احتمالها.'
        :`✍️ <b>تظليل الطالب اليدوي:</b> ظلّلت <b>${ar(cnt)}</b> من أصل <b>٣٦</b> نتيجة ← الاحتمال = ${frac(cnt,36)}${g>1?' = '+frac(sn,sd)+' (في أبسط صورة)':''}`;
    }else if(ev){
      $('#s1StProb').innerHTML=frac(ev.n,ev.d);
      $('#s1LabExplain').innerHTML=ev.exp;
    }else{
      $('#s1StProb').innerHTML=frac(0,36);
      $('#s1LabExplain').innerHTML='تم محو التظليل. اختر حدثاً من الأزرار أعلاه أو فعّل «✍️ تظليل الطالب يدوياً» للنقر على الخلايا.';
    }
  }

  $('#s1EventBtns').innerHTML=EVENTS.map((e,i)=>`<button class="btn ${i===0?'pri':''}" data-ei="${i}">${e.lbl}</button>`).join('');
  $('#s1EventBtns').addEventListener('click',e=>{
    const b=e.target.closest('button');if(!b)return;
    manualMode=false;
    $('#s1ManualBtn').classList.remove('on');
    curEv=+b.dataset.ei;
    $$('#s1EventBtns button').forEach((x,i)=>x.classList.toggle('pri',i===curEv));
    renderMatrix();
  });

  $('#s1ManualBtn').onclick=()=>{
    manualMode=true;
    curEv=-1;
    $$('#s1EventBtns button').forEach(x=>x.classList.remove('pri'));
    $('#s1ManualBtn').classList.add('on');
    renderMatrix();
  };

  $('#s1ClearBtn').onclick=()=>{
    manualSet.clear();
    pickedR=-1; pickedB=-1;
    if(!manualMode){
      curEv=-1;
      $$('#s1EventBtns button').forEach(x=>x.classList.remove('pri'));
    }
    $('#s1RollRes').textContent='اضغط لرمي الحجرين';
    renderMatrix();
  };

  $('#s1MatrixWrap').addEventListener('click',e=>{
    const td=e.target.closest('td[data-r]');if(!td)return;
    if(!manualMode){
      manualMode=true;
      curEv=-1;
      $$('#s1EventBtns button').forEach(x=>x.classList.remove('pri'));
      $('#s1ManualBtn').classList.add('on');
    }
    const key=`${td.dataset.r},${td.dataset.b}`;
    if(manualSet.has(key)) manualSet.delete(key);
    else manualSet.add(key);
    renderMatrix();
  });

  $('#s1TableMode').addEventListener('click',e=>{
    const b=e.target.closest('button');if(!b)return;
    mode=b.dataset.m;
    $$('#s1TableMode button').forEach(x=>x.classList.toggle('on',x===b));
    renderMatrix();
  });
  $('#s1RollBtn').onclick=()=>{
    pickedR=1+Math.floor(Math.random()*6);
    pickedB=1+Math.floor(Math.random()*6);
    const key=`${pickedR},${pickedB}`;
    const hit=manualMode?manualSet.has(key):(curEv>=0?EVENTS[curEv].fn(pickedR,pickedB):false);
    $('#s1RollRes').textContent=`أحمر: ${ar(pickedR)} ، أزرق: ${ar(pickedB)} (المجموع ${ar(pickedR+pickedB)}) · ${hit?'يحقق الحدث ✓':'لا يحقق الحدث'}`;
    renderMatrix();
  };
  renderMatrix();
}

