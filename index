function checkFrac(nId,dId,boxId,stId,targetN,targetD){
  const n=parseInt($('#'+nId).value,10), d=parseInt($('#'+dId).value,10);
  const box=$('#'+boxId), st=$('#'+stId);
  if((n===targetN && d===targetD) || (targetN===0 && n===0 && !isNaN(d) && d>0)){
    box.className='frac-inp ok';
    st.className='fb ok';
    st.innerHTML='✓ صحيح '+frac(targetN,targetD);
    return true;
  }else if(!isNaN(n) && !isNaN(d) && d!==0 && Math.abs(n/d - targetN/targetD)<1e-6){
    box.className='frac-inp no';
    st.className='fb no';
    st.innerHTML='بسّط الكسر لأبسط صورة';
    return false;
  }else{
    box.className='frac-inp no';
    st.className='fb no';
    st.innerHTML='✗ الصواب: '+frac(targetN,targetD);
    return false;
  }
}

