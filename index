function initGame(prefix, challenges){
  let idx=0, pts=0, streak=0, locked=false;
  function load(){
    locked=false; const c=challenges[idx];
    $(`#${prefix}GQNo`).textContent=ar(idx+1); $(`#${prefix}GPts`).textContent=ar(pts); $(`#${prefix}GStreak`).textContent=ar(streak);
    $(`#${prefix}GVisual`).innerHTML=`<div style="font-size:13.5px;color:var(--muted);font-weight:600">التجربة العشوائية</div><div style="font-family:var(--display);font-weight:800;font-size:22px;color:var(--teal);margin:6px 0">${c.given}</div><div class="pill">المطلوب: الاحتمال في أبسط صورة</div>`;
    $(`#${prefix}GPrompt`).textContent=c.q; $(`#${prefix}GHint`).innerHTML='تلميح: '+c.h;
    $(`#${prefix}GMsg`).className='verdict'; $(`#${prefix}GMsg`).textContent='اختر الإجابة الصحيحة في أبسط صورة.';
    $(`#${prefix}GOpts`).innerHTML=c.opts.map((o,i)=>`<button class="btn" data-i="${i}">${o}</button>`).join('');
  }
  $(`#${prefix}GOpts`).addEventListener('click',e=>{
    const b=e.target.closest('button');if(!b||locked)return;
    locked=true; const chosen=+b.dataset.i, c=challenges[idx];
    if(chosen===c.a){
      pts+=15; streak++; b.classList.add('pri');
      $(`#${prefix}GMsg`).className='verdict ok'; $(`#${prefix}GMsg`).textContent='أحسنت! +١٥ نقطة.';
    }else{
      streak=0; $(`#${prefix}GMsg`).className='verdict no'; $(`#${prefix}GMsg`).innerHTML='إجابة غير صحيحة. الصواب: '+c.opts[c.a];
    }
    $(`#${prefix}GPts`).textContent=ar(pts); $(`#${prefix}GStreak`).textContent=ar(streak);
    setTimeout(()=>{idx=(idx+1)%challenges.length;load()},1600);
  });
  load();
}

