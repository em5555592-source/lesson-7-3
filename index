function confetti(){
  if(RM)return;const c=$('#confetti'),x=c.getContext('2d');c.hidden=false;c.width=innerWidth;c.height=innerHeight;
  const cols=['#F0A445','#3AB1A6','#E0677C','#4C70C8','#8A63B5','#6FA93A'];
  const P=[...Array(150)].map(()=>({x:Math.random()*c.width,y:-Math.random()*c.height,vy:2+Math.random()*3,vx:-1+Math.random()*2,r:Math.random()*6.3,s:6+Math.random()*8,c:cols[Math.random()*6|0]}));
  const t0=performance.now();
  const f=now=>{
    x.clearRect(0,0,c.width,c.height);
    P.forEach(p=>{p.y+=p.vy;p.x+=p.vx;p.r+=.1;x.save();x.translate(p.x,p.y);x.rotate(p.r);x.fillStyle=p.c;x.fillRect(-p.s/2,-p.s/4,p.s,p.s/2);x.restore()});
    if(now-t0<4500&&!c.hidden)requestAnimationFrame(f);else x.clearRect(0,0,c.width,c.height);
  };
  requestAnimationFrame(f);
}

