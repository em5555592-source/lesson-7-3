/* ---------- Hero Interactive Canvas (Red & Blue Dice + 36 Sample Space) ---------- */
{
  const cv=$('#heroCanvas'), ctx=cv.getContext('2d');
  let rVal=5, bVal=4, timer=0;
  function css(n){return getComputedStyle(document.documentElement).getPropertyValue(n).trim()}
  function drawDie(cx,cy,size,val,bg){
    ctx.save();
    ctx.translate(cx,cy);
    ctx.beginPath();
    ctx.roundRect(-size/2,-size/2,size,size,14);
    ctx.fillStyle=bg;
    ctx.fill();
    ctx.lineWidth=2.5;
    ctx.strokeStyle='#FFFFFF';
    ctx.stroke();

    ctx.fillStyle='#FFFFFF';
    const d=size*0.26, pr=size*0.09;
    const pips={
      1:[[0,0]],
      2:[[-d,-d],[d,d]],
      3:[[-d,-d],[0,0],[d,d]],
      4:[[-d,-d],[d,-d],[-d,d],[d,d]],
      5:[[-d,-d],[d,-d],[0,0],[-d,d],[d,d]],
      6:[[-d,-d],[d,-d],[-d,0],[d,0],[-d,d],[d,d]]
    };
    pips[val].forEach(([px,py])=>{
      ctx.beginPath();
      ctx.arc(px,py,pr,0,Math.PI*2);
      ctx.fill();
    });
    ctx.restore();
  }
  function drawHero(){
    const dpr=devicePixelRatio||1, w=cv.clientWidth, h=cv.clientHeight;
    if(!w||!h)return;
    cv.width=w*dpr; cv.height=h*dpr; ctx.setTransform(dpr,0,0,dpr,0,0);
    ctx.clearRect(0,0,w,h);

    const sz=68, cy=h*0.34;
    drawDie(w/2 + 52, cy, sz, rVal, '#C1435A');
    drawDie(w/2 - 52, cy, sz, bVal, '#3556A8');

    const gSz=14, gap=4, total=6*(gSz+gap)-gap;
    const gx0=(w-total)/2, gy0=cy+52;
    for(let r=1;r<=6;r++){
      for(let b=1;b<=6;b++){
        const x=gx0+(6-b)*(gSz+gap), y=gy0+(r-1)*(gSz+gap);
        const isCur=(r===rVal && b===bVal);
        ctx.fillStyle=isCur?css('--accent'):css('--line');
        ctx.beginPath();
        ctx.roundRect(x,y,gSz,gSz,3);
        ctx.fill();
      }
    }
  }
  const loop=()=>{
    if(!RM){
      timer++;
      if(timer%90===0){
        rVal=1+Math.floor(Math.random()*6);
        bVal=1+Math.floor(Math.random()*6);
        drawHero();
      }
    }
    requestAnimationFrame(loop);
  };
  drawHero(); requestAnimationFrame(loop);
  window.addEventListener('resize',drawHero);
}

