      $$('.opt',card).forEach((o,k)=>{if(k===q.a)o.classList.add('right');else if(k===j)o.classList.add('wrong')});
      const w=$('.why',card);w.hidden=false;w.innerHTML=(j===q.a?'إجابة صحيحة. ':'الإجابة الصحيحة: '+LET[q.a]+'. ')+q.w;
      onScore&&onScore(Object.keys(ans).filter(k=>ans[k]===QS[k].a).length,Object.keys(ans).length);
    }else{
      $$('.opt',card).forEach(o=>o.classList.toggle('sel',o===b));ans[i]=+b.dataset.j;
    }
  };
  return {ans,grade(){
    let c=0;
    $$('.qq',box).forEach((card,i)=>{
      card.dataset.locked=1;const q=QS[i],j=ans[i];
      $$('.opt',card).forEach((o,k)=>{o.classList.remove('sel');if(k===q.a)o.classList.add('right');else if(k===j)o.classList.add('wrong')});
      if(j===q.a)c++;const w=$('.why',card);w.hidden=false;w.innerHTML=(j===q.a?'صحيح. ':j==null?'لم تُجب. ':'خطأ. ')+q.w;
    });
    return c;
  }};
}

function initCompetition(boxId, logKey, CQ){
  const box=$('#'+boxId);
  const comp={g:[],qi:0,phase:'setup',left:QT,tick:null,t0:0,ans:{}};
  function compSetup(){
    comp.phase='setup'; const n=comp.g.length||4;
    box.innerHTML=`<div class="ghead"><h3 style="font-size:21px">إعداد المسابقة</h3><button class="btn cFull">ملء الشاشة</button></div>
    <p class="muted">${ar(CQ.length)} أسئلة · ${ar(QT)} ثانية لكل سؤال. تضغط كل مجموعة على حرف إجابتها، ويُحتسب زمن الإجابة.</p>
    <div class="row" style="margin:12px 0"><label>عدد المجموعات</label><select class="cN">${[2,3,4,5,6].map(k=>`<option value="${k}" ${k===n?'selected':''}>${ar(k)}</option>`).join('')}</select></div>
    <div class="groups cNames"></div><div class="row" style="margin-top:14px"><button class="btn pri cStart">ابدأ المسابقة</button></div>
    <div class="cLog" style="margin-top:16px"></div>`;
    const names=()=>{const k=+$('.cN',box).value;$('.cNames',box).innerHTML=[...Array(k)].map((_,i)=>`<div class="gp"><label>المجموعة ${ar(i+1)}</label><input value="${(comp.g[i]&&comp.g[i].name)||DEFAULT_G[i]||'المجموعة '+ar(i+1)}"></div>`).join('')};
    names(); $('.cN',box).onchange=names;
    $('.cFull',box).onclick=()=>{box.requestFullscreen&&box.requestFullscreen().catch(()=>{})};
    $('.cStart',box).onclick=()=>{comp.g=$$('.cNames input',box).map(i=>({name:i.value.trim()||'مجموعة',pts:0,correct:0,time:0}));comp.qi=0;askQ()};
    renderLog();
  }
  function askQ(){
    comp.phase='ask'; comp.ans={}; comp.left=QT; comp.t0=performance.now(); const q=CQ[comp.qi];
    box.innerHTML=`<div class="ghead"><span class="pill" style="background:transparent;color:inherit;border-color:var(--cline)">السؤال ${ar(comp.qi+1)} من ${ar(CQ.length)}</span><span class="score num cLeft">${ar(QT)} ث</span></div>
    <div class="timer"><i class="cBar"></i></div><p class="cq">${q.q}</p><div class="copts">${q.o.map((o,j)=>`<div class="copt" data-j="${j}"><span class="l">${LET[j]}</span>${o}</div>`).join('')}</div>
    <div class="groups">${comp.g.map((g,i)=>`<div class="gp" data-g="${i}"><div class="gn"><span>${g.name}</span><span class="num">${ar(g.pts)}</span></div><div class="gb">${LET.map((l,j)=>`<button data-j="${j}">${l}</button>`).join('')}</div><div class="st muted">بانتظار الإجابة</div></div>`).join('')}</div>
    <div class="cRev" style="margin-top:12px"></div>`;
    box.querySelectorAll('.gp').forEach(p=>p.onclick=e=>{
      const b=e.target.closest('button');if(!b||comp.phase!=='ask')return;
      const g=+p.dataset.g;if(comp.ans[g])return;
      const t=(performance.now()-comp.t0)/1000;
      comp.ans[g]={j:+b.dataset.j,t}; b.classList.add('pick');
      $('.st',p).textContent=`أجابت خلال ${ar(t.toFixed(1))} ث`;
      if(Object.keys(comp.ans).length===comp.g.length)reveal();
    });
    clearInterval(comp.tick);
    comp.tick=setInterval(()=>{
      const el=(performance.now()-comp.t0)/1000; comp.left=Math.max(0,QT-el);
      const lt=$('.cLeft',box), bar=$('.cBar',box);
      if(lt)lt.textContent=ar(Math.ceil(comp.left))+' ث';
      if(bar)bar.style.width=(comp.left/QT*100)+'%';
      if(comp.left<=0)reveal();
    },200);
  }
  function reveal(){
    if(comp.phase!=='ask')return; comp.phase='reveal'; clearInterval(comp.tick); const q=CQ[comp.qi];
    $$('.copt',box).forEach(c=>c.classList.toggle('right',+c.dataset.j===q.a));
    comp.g.forEach((g,i)=>{
      const a=comp.ans[i], p=$(`.gp[data-g="${i}"]`,box); let got=0;
      if(a&&a.j===q.a){
        got=10+Math.round(5*Math.max(0,QT-a.t)/QT); g.correct++; g.time+=a.t; p.classList.add('ok');
        $('.st',p).textContent=`صحيح · +${ar(got)} (دقة ١٠ + سرعة ${ar(got-10)})`;
      }else{
        p.classList.add('no'); $('.st',p).textContent=a?`خطأ · اختارت ${LET[a.j]}`:'انتهى الوقت';
      }
      g.pts+=got; $('.gn .num',p).textContent=ar(g.pts);
    });
    const last=comp.qi===CQ.length-1;
    $('.cRev',box).innerHTML=`<div class="card"><b>التغذية الراجعة:</b> الإجابة الصحيحة (${LET[q.a]}) ${q.o[q.a]}. ${q.w}</div><div class="row" style="margin-top:10px"><button class="btn pri cNext">${last?'عرض النتائج':'السؤال التالي'}</button></div>`;
    $('.cNext',box).onclick=()=>{if(last)finish();else{comp.qi++;askQ()}};
  }
  function ranked(){return comp.g.map((g,i)=>({...g,i})).sort((a,b)=>b.pts-a.pts||b.correct-a.correct||a.time-b.time)}
  function finish(){
    comp.phase='done'; const r=ranked(), top=r[0], win=r.filter(g=>g.pts===top.pts&&g.correct===top.correct&&Math.abs(g.time-top.time)<.05);
    box.innerHTML=`<div class="ghead"><h3 style="font-size:21px">النتائج النهائية</h3><button class="btn cAgain">مسابقة جديدة</button></div>
    <div class="tbl-wrap"><table class="board"><thead><tr><th>الترتيب</th><th>المجموعة</th><th>الإجابات الصحيحة</th><th>زمن الإجابة</th><th>النقاط</th></tr></thead><tbody>
    ${r.map((g,k)=>`<tr class="${win.includes(g)?'win':''}"><td class="num">${ar(k+1)}</td><td>${g.name}</td><td class="num">${ar(g.correct)} / ${ar(CQ.length)}</td><td class="num">${ar(g.time.toFixed(1))} ث</td><td class="num">${ar(g.pts)}</td></tr>`).join('')}</tbody></table></div>
    <div class="row" style="margin-top:12px"><button class="btn pri cSave">حفظ في سجل الدرجات</button><button class="btn cCopy">نسخ الدرجات (Excel)</button><button class="btn cShow">إعلان الفائز</button><span class="fb cFb"></span></div>
    <div class="cLog" style="margin-top:16px"></div>`;
    const tsv=()=>['الترتيب\tالمجموعة\tالصحيحة\tالزمن\tالنقاط',...r.map((g,k)=>`${k+1}\t${g.name}\t${g.correct}\t${g.time.toFixed(1)}\t${g.pts}`)].join('\n');
    $('.cCopy',box).onclick=()=>copyText(tsv(),$('.cFb',box));
    $('.cSave',box).onclick=()=>{
      const log=store.get(logKey,[]);
      log.unshift({d:new Date().toLocaleString('ar-OM'),r:r.map(g=>({n:g.name,c:g.correct,p:g.pts}))});
      store.set(logKey,log.slice(0,20));
      $('.cFb',box).className='fb ok'; $('.cFb',box).textContent='حُفظت في سجل الجهاز'; renderLog();
    };
    $('.cAgain',box).onclick=compSetup; $('.cShow',box).onclick=()=>announce(win); renderLog(); announce(win);
  }
  function renderLog(){
    const el=$('.cLog',box);if(!el)return;const log=store.get(logKey,[]);if(!log.length){el.innerHTML='';return}
    el.innerHTML=`<h3 style="font-size:17px;margin-bottom:6px">سجل الدرجات</h3><div class="tbl-wrap"><table class="board"><thead><tr><th>التاريخ</th><th>المجموعة · النقاط</th></tr></thead><tbody>${log.map(s=>`<tr><td>${s.d}</td><td>${s.r.map(g=>`${g.n}: ${ar(g.p)}`).join(' · ')}</td></tr>`).join('')}</tbody></table></div>`;
  }
  compSetup();
}

