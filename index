<style>
:root{
  --paper:#EEF2F7; --card:#FFFFFF; --ink:#13233F; --muted:#56627A; --line:#D3DAE6; --dot:#C3CCDB;
  --accent:#D9861C; --accent-ink:#FFFFFF; --teal:#11766F; --maroon:#9E2639; --soft:#F6F8FB;
  --good:#1D8048; --good-bg:#E3F3E9; --bad:#BC322B; --bad-bg:#FBE6E4;
  --f1:#D9861C; --f2:#11766F; --f3:#9E2639; --f4:#3556A8; --f5:#6E4597; --f6:#58902A;
  --display:"Cairo","IBM Plex Sans Arabic",Tahoma,sans-serif;
  --body:"IBM Plex Sans Arabic",Tahoma,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --paper:#0D1524; --card:#152038; --ink:#E7ECF5; --muted:#9AA7BF; --line:#2A3755; --dot:#26324C;
  --accent:#F0A445; --accent-ink:#1A1205; --teal:#3AB1A6; --maroon:#E0677C; --soft:#1A2642;
  --good:#52C584; --good-bg:#16352A; --bad:#F16D62; --bad-bg:#3A1C1F;
  --f1:#E39530; --f2:#1E9389; --f3:#C1435A; --f4:#4C70C8; --f5:#8A63B5; --f6:#6FA93A;
  color-scheme:dark}}
:root[data-theme="dark"]{
  --paper:#0D1524; --card:#152038; --ink:#E7ECF5; --muted:#9AA7BF; --line:#2A3755; --dot:#26324C;
  --accent:#F0A445; --accent-ink:#1A1205; --teal:#3AB1A6; --maroon:#E0677C; --soft:#1A2642;
  --good:#52C584; --good-bg:#16352A; --bad:#F16D62; --bad-bg:#3A1C1F;
  --f1:#E39530; --f2:#1E9389; --f3:#C1435A; --f4:#4C70C8; --f5:#8A63B5; --f6:#6FA93A;
  color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;padding:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.75;direction:rtl;
  background-image:radial-gradient(var(--dot) 1.2px,transparent 1.3px);background-size:22px 22px}
.page{max-width:1140px;margin:0 auto;padding:12px 16px 60px}
h1,h2,h3{font-family:var(--display);font-weight:800;line-height:1.35;margin:0;letter-spacing:0}
p{margin:0}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
a{color:var(--teal)}
.num{font-variant-numeric:tabular-nums}

/* Vertical Fraction Component (Strictly No Slashes) */
.frac{display:inline-flex;flex-direction:column;align-items:center;vertical-align:middle;line-height:1.12;margin:0 4px;font-variant-numeric:tabular-nums;font-weight:700}
.frac>span:first-child{border-bottom:1.6px solid currentColor;padding:0 5px 2px}
.frac>span:last-child{padding:2px 5px 0}
.frac.lg{font-size:1.12em}

/* Header */
.top{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:20px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px;margin-top:6px;position:relative}
.author-badge{position:absolute;top:16px;left:18px;text-align:left;background:var(--soft);border:1px solid var(--line);padding:6px 14px;border-radius:12px;font-size:13.5px}
.author-badge b{display:block;font-family:var(--display);font-weight:800;font-size:15.5px;color:var(--maroon)}
.org{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:14px;color:var(--muted);font-weight:600;padding-left:205px}
.org b{color:var(--ink)}
.lessonno{display:inline-block;font-family:var(--display);font-weight:800;color:var(--accent);font-size:17px;margin-top:14px}
.top h1{font-size:clamp(24px,3.8vw,35px);margin-top:4px;color:var(--ink)}
.top .lead{color:var(--muted);margin-top:8px;max-width:56ch}
.meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.pill{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:3px 12px;font-size:13px;background:var(--soft);font-weight:600}
.theme-btn{border:1px solid var(--line);background:var(--soft);border-radius:999px;padding:3px 12px;font-size:13px;font-weight:600}
@media (max-width:860px){
  .top{grid-template-columns:1fr}
  .author-badge{position:static;margin-bottom:10px;text-align:right;display:inline-block}
  .org{padding-left:0}
}

/* Hero Canvas */
.hero-box{position:relative;height:275px;border-radius:16px;background:radial-gradient(circle at 50% 55%,var(--soft),transparent 72%);display:grid;place-items:center;overflow:hidden;border:1px solid var(--line)}
#heroCanvas{width:100%;height:100%;display:block}
.hero-cap{position:absolute;bottom:8px;font-size:13px;font-weight:700;color:var(--teal);background:var(--card);padding:4px 14px;border-radius:999px;border:1px solid var(--line);display:flex;align-items:center;gap:6px}

/* Master Session Switcher (2 Prominent Tabs) */
.master-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}
@media (max-width:740px){.master-tabs{grid-template-columns:1fr}}
.m-tab{border:2.5px solid var(--line);background:var(--card);border-radius:16px;padding:15px 18px;text-align:start;display:grid;gap:5px;transition:all .18s;position:relative;box-shadow:0 4px 12px rgba(0,0,0,.03)}
.m-tab:hover{border-color:var(--accent)}
.m-tab .m-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.m-tab .m-badge{font-size:12.5px;font-weight:700;padding:2px 10px;border-radius:999px;background:var(--soft);border:1px solid var(--line);color:var(--muted);flex:none}
.m-tab b{font-family:var(--display);font-weight:800;font-size:18px;color:var(--ink)}
.m-tab span.m-sub{font-size:13.5px;color:var(--muted);line-height:1.55}
.m-tab.on{border-color:var(--teal);background:linear-gradient(135deg,var(--card),rgba(17,118,111,.08));box-shadow:0 6px 20px rgba(17,118,111,.14)}
.m-tab.on b{color:var(--teal)}
.m-tab.on .m-badge{background:var(--teal);color:#fff;border-color:var(--teal)}
.m-tab[data-session="2"].on{border-color:var(--accent);background:linear-gradient(135deg,var(--card),rgba(217,134,28,.1));box-shadow:0 6px 20px rgba(217,134,28,.14)}
.m-tab[data-session="2"].on b{color:var(--accent)}
.m-tab[data-session="2"].on .m-badge{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}

/* Sticky Nav */
.nav{position:sticky;top:6px;z-index:20;margin:12px 0 6px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:6px;display:flex;gap:4px;overflow-x:auto;scrollbar-width:thin;box-shadow:0 4px 16px rgba(0,0,0,.05)}
.nav a{flex:none;text-decoration:none;color:var(--ink);font-size:13.5px;font-weight:600;padding:6px 11px;border-radius:9px;white-space:nowrap}
.nav a:hover,.nav a.on{background:var(--accent);color:var(--accent-ink)}
.nav .nav-s-pill{flex:none;display:inline-flex;align-items:center;padding:4px 10px;border-radius:9px;font-size:12.5px;font-weight:800;background:var(--ink);color:var(--paper);margin-inline-end:4px}

/* Session Panels */
.session-pane[hidden]{display:none!important}

/* Sections & Cards */
.sec{margin-top:26px;scroll-margin-top:68px}
.sec-h{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.sec-h .n{flex:none;width:38px;height:38px;border-radius:10px;background:var(--ink);color:var(--paper);display:grid;place-items:center;font-family:var(--display);font-weight:800;font-size:18px}
.sec-h h2{font-size:clamp(20px,2.8vw,25px)}
.sec-h small{display:block;color:var(--muted);font-family:var(--body);font-size:13.5px;font-weight:500;margin-top:2px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.split{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:16px}
@media (max-width:780px){.grid2,.grid3,.split{grid-template-columns:1fr}}
.card h3{font-size:19px;margin-bottom:8px}
.muted{color:var(--muted)}
.olist{margin:0;padding-inline-start:22px;display:grid;gap:6px}
.olist li::marker{color:var(--accent);font-weight:700}

/* Buttons & Controls */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:1px solid var(--line);background:var(--soft);border-radius:10px;padding:8px 14px;font-weight:600;font-size:14.5px;min-height:40px}
.btn:hover{border-color:var(--accent)}
.btn.pri{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.dark{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.btn.on{background:var(--teal);color:#fff;border-color:var(--teal)}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.seg{display:inline-flex;flex-wrap:wrap;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.seg button{border:none;background:var(--card);padding:7px 12px;font-weight:600;font-size:13.5px;border-inline-end:1px solid var(--line)}
.seg button:last-child{border-inline-end:none}
.seg button.on{background:var(--ink);color:var(--paper)}

/* Interactive Sample Space Matrix (6x6 Dice) */
.ss-table{width:100%;border-collapse:collapse;text-align:center;font-size:13.5px;font-variant-numeric:tabular-nums}
.ss-table th{background:var(--accent);color:var(--accent-ink);padding:7px 4px;border:1px solid var(--line);font-family:var(--display);font-weight:800}
.ss-table th.row-h{background:var(--teal);color:#fff}
.ss-table td{padding:7px 4px;border:1px solid var(--line);background:var(--card);font-weight:700;cursor:pointer;transition:all .15s;user-select:none}
.ss-table td:hover{border-color:var(--accent)}
.ss-table td.hl{background:var(--teal);color:#fff;border-color:var(--teal);transform:scale(1.03)}
.ss-table td.picked{outline:3px solid var(--maroon);outline-offset:-2px;z-index:2;position:relative}
.red-num{color:#D63031;font-weight:800}
.blue-num{color:#2563EB;font-weight:800}
.ss-table td.hl .red-num,.ss-table td.hl .blue-num{color:#FFF}

/* Interactive Two-Way Tables (Session 2) */
.tw-table{width:100%;border-collapse:collapse;text-align:center;font-size:14px;font-variant-numeric:tabular-nums}
.tw-table th{background:var(--ink);color:var(--paper);padding:7px 5px;border:1px solid var(--line);font-family:var(--display);font-weight:700}
.tw-table th.sub-h{background:var(--soft);color:var(--ink);font-weight:800}
.tw-table td{padding:7px 5px;border:1px solid var(--line);background:var(--card);font-weight:600;cursor:pointer;transition:all .15s;user-select:none}
.tw-table td:hover{border-color:var(--accent)}
.tw-table td.hl{background:var(--accent);color:var(--accent-ink);font-weight:800}
.tw-table td.imp{background:var(--bad-bg);color:var(--maroon);font-weight:800;cursor:not-allowed}

/* Differentiation Tabs & Cards */
.diff-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
@media (max-width:640px){.diff-tabs{grid-template-columns:1fr}}
.diff-tab{border:2px solid var(--line);background:var(--card);border-radius:14px;padding:12px;text-align:start;display:grid;gap:4px;transition:transform .15s}
.diff-tab b{font-family:var(--display);font-weight:800;font-size:16.5px}
.diff-tab span{font-size:13px;color:var(--muted)}
.diff-tab.t1.on{border-color:var(--good);background:var(--good-bg)}
.diff-tab.t2.on{border-color:var(--accent);background:rgba(217,134,28,.12)}
.diff-tab.t3.on{border-color:var(--maroon);background:rgba(158,38,57,.12)}
.diff-panel{display:grid;gap:14px}
.diff-task{border:1px solid var(--line);background:var(--soft);border-radius:14px;padding:14px;display:grid;gap:10px}
.diff-task .tag{display:inline-block;padding:2px 10px;border-radius:999px;font-size:12.5px;font-weight:700;width:fit-content}
.tag.g{background:var(--good-bg);color:var(--good)}
.tag.m{background:rgba(217,134,28,.18);color:var(--accent)}
.tag.h{background:var(--bad-bg);color:var(--maroon)}
.scaff-box{background:var(--card);border-inline-start:4px solid var(--teal);padding:8px 12px;border-radius:8px;font-size:14px}

/* Fraction Input Box */
.frac-inp{display:inline-flex;flex-direction:column;align-items:center;vertical-align:middle;margin:0 4px;background:var(--card);padding:4px 6px;border-radius:10px;border:1px solid var(--line)}
.frac-inp input{width:56px;text-align:center;padding:3px;border:1.5px solid var(--line);border-radius:6px;background:var(--soft);color:var(--ink);font:inherit;font-weight:700;font-size:14px}
.frac-inp .bar{width:100%;height:2px;background:var(--ink);margin:3px 0}
.frac-inp.ok{border-color:var(--good);background:var(--good-bg)}
.frac-inp.no{border-color:var(--bad);background:var(--bad-bg)}

/* Criteria */
.crit{display:flex;gap:10px;align-items:flex-start;padding:8px 10px;border-radius:10px;border:1px solid transparent;text-align:start;background:none;width:100%}
.crit .box{flex:none;width:22px;height:22px;border-radius:6px;border:2px solid var(--teal);margin-top:3px;display:grid;place-items:center;font-size:14px;color:var(--card)}
.crit[aria-pressed="true"] .box{background:var(--teal)}
.crit[aria-pressed="true"]{background:var(--soft);border-color:var(--line)}

/* Vocab & Formula Box */
.vocab{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
.term{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;display:grid;gap:8px;align-content:start}
.term b{font-family:var(--display);font-weight:800;font-size:18.5px;color:var(--maroon)}
.formula-banner{background:var(--soft);border:1.5px solid var(--teal);border-radius:12px;padding:12px 14px;font-weight:700;color:var(--teal);text-align:center;font-size:16px;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:6px}

/* Flip Cards */
.flips{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.flip{min-height:132px;border-radius:14px;border:1px solid var(--line);background:var(--card);padding:14px;text-align:start;display:grid;gap:8px;align-content:start}
.flip .q{font-weight:700}
.flip .a{color:var(--teal);font-weight:700}
.flip .hint{font-size:13px;color:var(--muted)}

/* Warmup Sort */
.items{display:grid;grid-template-columns:repeat(auto-fit,minmax(235px,1fr));gap:12px}
.item{border:1px solid var(--line);border-radius:14px;background:var(--card);padding:14px;display:grid;gap:8px;justify-items:center;text-align:center}
.item .btn{font-size:14px;padding:6px 12px;min-height:38px}
.fb{font-size:14px;font-weight:600;min-height:1.5em}
.fb.ok{color:var(--good)} .fb.no{color:var(--bad)}

/* Flow */
.flow{display:grid;gap:10px}
.step{display:grid;grid-template-columns:92px minmax(0,1fr);gap:14px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px}
.step .t{font-family:var(--display);font-weight:800;color:var(--accent);font-size:15px;line-height:1.3}
.step .t span{display:block;font-size:26px;color:var(--ink)}
.step h3{font-size:18px}
.step .roles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:6px;font-size:14.5px}
.step .roles div{background:var(--soft);border-radius:10px;padding:8px 10px}
.step .roles b{display:block;font-size:13px;color:var(--muted)}
@media (max-width:600px){.step{grid-template-columns:1fr}.step .roles{grid-template-columns:1fr}}

/* Stats & Verdicts */
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}
.stat{background:var(--soft);border:1px solid var(--line);border-radius:12px;padding:8px;text-align:center}
.stat b{display:block;font-family:var(--display);font-weight:800;font-size:20px;color:var(--accent)}
.stat small{font-size:12.5px;color:var(--muted);font-weight:600}

.verdict{border-radius:12px;padding:10px 14px;font-weight:600;background:var(--soft);border:1px solid var(--line)}
.verdict.ok{background:var(--good-bg);color:var(--good);border-color:transparent}
.verdict.no{background:var(--bad-bg);color:var(--bad);border-color:transparent}

/* Quizzes */
.quiz{display:grid;gap:12px}
.qq{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px}
.qq .qt{font-weight:700;display:flex;gap:8px;align-items:baseline}
.qq .qt .k{flex:none;color:var(--accent);font-family:var(--display)}
.opts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
@media (max-width:540px){.opts{grid-template-columns:1fr}}
.opt{text-align:start;border:1.5px solid var(--line);background:var(--soft);border-radius:10px;padding:8px 12px;display:flex;gap:10px;align-items:center;font-weight:500}
.opt .l{flex:none;width:26px;height:26px;border-radius:50%;background:var(--card);border:1px solid var(--line);display:grid;place-items:center;font-weight:700;font-size:14px}
.opt.sel{border-color:var(--ink)}
.opt.sel .l{background:var(--ink);color:var(--paper)}
.opt.right{border-color:var(--good);background:var(--good-bg)}
.opt.wrong{border-color:var(--bad);background:var(--bad-bg)}
.why{margin-top:10px;font-size:14.5px;padding:8px 12px;border-radius:10px;background:var(--soft);border-inline-start:4px solid var(--teal)}
.score{font-family:var(--display);font-weight:800;font-size:19px}
.result{border-radius:14px;padding:16px;background:var(--ink);color:var(--paper);display:grid;gap:6px}
.result b{font-family:var(--display);font-size:30px;color:var(--accent)}

/* Competition */
.comp{background:var(--ink);color:var(--paper);border-radius:18px;padding:18px;--cline:rgba(255,255,255,.18)}
.comp:fullscreen{overflow:auto;padding:28px}
.comp .card{background:rgba(255,255,255,.06);border-color:var(--cline);color:var(--paper)}
.comp input,.comp select{background:rgba(255,255,255,.1);color:var(--paper);border:1px solid var(--cline);border-radius:8px;padding:6px 10px;font:inherit;min-width:0}
.comp .btn{background:rgba(255,255,255,.1);border-color:var(--cline);color:var(--paper)}
.comp .btn.pri{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.comp .muted{color:rgba(255,255,255,.72)}
.ghead{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;align-items:center}
.timer{height:10px;border-radius:99px;background:rgba(255,255,255,.12);overflow:hidden;margin:10px 0}
.timer i{display:block;height:100%;background:var(--accent);width:100%;transition:width .25s linear}
.cq{font-family:var(--display);font-weight:800;font-size:clamp(19px,2.8vw,25px);margin:8px 0}
.copts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.copt{border:1px solid var(--cline);border-radius:10px;padding:8px 12px;display:flex;gap:10px;align-items:center;font-weight:600}
.copt .l{width:28px;height:28px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;flex:none}
.copt.right{background:var(--good);color:#fff;border-color:var(--good)}
.groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;margin-top:14px}
.gp{border:1px solid var(--cline);border-radius:12px;padding:10px;display:grid;gap:8px}
.gp .gn{display:flex;justify-content:space-between;font-weight:700}
.gp .gb{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.gp .gb button{border:1px solid var(--cline);background:rgba(255,255,255,.08);color:var(--paper);border-radius:8px;min-height:42px;font-weight:700;font-size:18px}
.gp .gb button.pick{background:var(--accent);color:var(--accent-ink)}
.gp .st{font-size:13.5px;min-height:1.5em}
.gp.ok{border-color:var(--good);box-shadow:inset 0 0 0 1px var(--good)}
.gp.no{border-color:var(--bad)}
.board{width:100%;border-collapse:collapse;font-size:15px}
.board th,.board td{padding:8px;border-bottom:1px solid var(--cline);text-align:start}
.board tr.win td{color:var(--accent);font-weight:700}

/* Overlay & Confetti */
.overlay{position:fixed;inset:0;z-index:50;background:rgba(8,14,28,.88);display:grid;place-items:center;padding:24px;text-align:center;color:#fff}
.overlay[hidden]{display:none!important}
.overlay h2{font-size:clamp(34px,8vw,72px);color:#F0A445}
.overlay p{font-size:clamp(18px,3vw,26px)}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:51}

/* Homework */
.field{display:grid;gap:4px}
.field label{font-weight:600;font-size:14px}
.field input,.field textarea{font:inherit;color:var(--ink);background:var(--soft);border:1px solid var(--line);border-radius:10px;padding:8px 10px;width:100%}
.field textarea{min-height:74px;resize:vertical}
.mail{display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:var(--soft);border:1px solid var(--line);border-radius:12px;padding:10px 12px}
.mail code{font-size:16px;font-weight:700;direction:ltr;user-select:all;color:var(--maroon)}
pre.msg{white-space:pre-wrap;background:var(--soft);border:1px solid var(--line);border-radius:10px;padding:12px;font-family:var(--body);font-size:14px;max-height:260px;overflow:auto;margin:0}

/* Mind Map */
.mm-wrap{overflow-x:auto;background:var(--card);border:1px solid var(--line);border-radius:16px}
.mm-wrap svg{display:block;min-width:820px;width:100%;height:auto}

/* Game */
.game-card{background:var(--soft);border:1px solid var(--line);border-radius:14px;padding:14px;display:grid;gap:10px}
.game-opts{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}

/* Spinner & Coin Visuals */
.spin-box{display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:center;padding:10px}
.spin-svg{width:130px;height:130px}

.foot{margin-top:36px;text-align:center;color:var(--muted);font-size:14px}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
